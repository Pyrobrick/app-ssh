#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: Advanced SSH & Web Terminal
# Runs ttyd for tmux or Zellij's native web client for Zellij sessions
# ==============================================================================
declare -a options
declare ingress_entry
declare ingress_ip
declare ingress_port
declare supervisor_ip

# shellcheck disable=SC1091
source /etc/terminal-session.conf

case "${TERMINAL_SESSION_BACKEND}" in
    zellij)
        bashio::log.info 'Starting the native Zellij web client...'

        ingress_entry=$(bashio::app.ingress_entry)
        ingress_ip=$(bashio::app.ip_address)
        ingress_port=$(bashio::app.ingress_port)
        supervisor_ip=$(bashio::supervisor.ip_address)

        export INGRESS_ENTRY="${ingress_entry}"
        export INGRESS_IP="${ingress_ip}"
        export INGRESS_PORT="${ingress_port}"
        export SUPERVISOR_IP="${supervisor_ip}"

        exec /usr/local/bin/zellij-web
        ;;
    tmux)
        bashio::log.info 'Starting the ttyd daemon...'

        if bashio::debug; then
            options+=(-d7)
        else
            options+=(-d1)
        fi

        options+=(-i hassio)
        options+=(--writable)

        ingress_port=$(bashio::app.ingress_port)
        options+=(-p "${ingress_port}")

        cd /root || bashio::exit.nok 'Unable to change working directory'
        export TTYD=1

        exec ttyd "${options[@]}" /usr/local/bin/terminal-session
        ;;
    *)
        bashio::exit.nok \
            "Unsupported session backend: ${TERMINAL_SESSION_BACKEND}"
        ;;
esac
