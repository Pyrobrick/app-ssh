#!/bin/sh
set -eu

# OpenSSH invokes the configured account shell with `-c command` for remote
# commands. Run those commands through root's POSIX login shell so scripting,
# rsync, scp and similar clients do not inherit the selected interactive shell.
# Mosh also bootstraps through this command-mode path and therefore starts Bash.
if [ "${1:-}" = '-c' ]; then
    shift
    exec sudo -H /bin/bash -lc "${1:-}"
fi

exec sudo -i
