#!/bin/sh
set -eu

config_path="${TERMINAL_CONFIG_PATH:-/etc/terminal-session.conf}"
# shellcheck disable=SC1090
. "${config_path}"

shell_command="${TERMINAL_SHELL_COMMAND:-/usr/local/bin/terminal-shell}"

case "${TERMINAL_SESSION_BACKEND}" in
    zellij)
        export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/data/zellij/cache}"
        export XDG_DATA_HOME="${XDG_DATA_HOME:-/data/zellij/data}"
        export ZELLIJ_CONFIG_FILE="${ZELLIJ_CONFIG_FILE:-/etc/zellij/config.kdl}"

        exec zellij --config "${ZELLIJ_CONFIG_FILE}" \
            attach --create homeassistant options \
            --default-shell "${shell_command}" \
            --mirror-session true \
            --simplified-ui true \
            --web-sharing on
        ;;
    tmux)
        exec tmux -u new -A -s homeassistant "${shell_command}"
        ;;
    *)
        echo "Unsupported session backend: ${TERMINAL_SESSION_BACKEND}" >&2
        exit 1
        ;;
esac
